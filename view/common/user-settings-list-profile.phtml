<?php
/**
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\UserRepresentation $user
 * @var \Omeka\Settings\UserSettings $userSettings
 * @var array $fields
 */

// Like show.

$plugins = $this->getHelperPluginManager();
$escape = $plugins->get('escapeHtml');
$translate = $plugins->get('translate');

$userId = $user->id();
?>

<style>
.value.user-profile .value + .value.user-profile .value:before {
    content: '; ';
}
</style>

<dl>
    <div class="property user-profile">
        <dt><?= $translate('User profile') ?></dt>
        <dd class="value user-profile">
            <ul class="user-profile">
                <?php foreach ($fields as $field => $label): ?>
                <li>
                    <span class="user-profile-field"><?= $translate($label) ?>:</span>
                    <?php $values = $userSettings->get($field, null, $userId); ?>
                    <?php if (!is_array($values)) $values = [$values]; ?>
                    <?php foreach ($values as $value): ?>
                    <?php if (is_array($value)): ?>
                    <ul>
                        <?php foreach ($value as $key => $val): ?>
                        <li>
                            <span class="label"><?= $escape($key) ?></span> :
                            <span class="value"><?= $escape(is_array($val) ? implode(', ', $val) : $val) ?></span>
                        </li>
                        <?php endforeach; ?>
                    </ul>
                    <?php else: ?>
                    <span class="value"><?= $escape($value) ?></span>
                    <?php endif; ?>
                    <br/>
                    <?php endforeach; ?>
                </li>
                <?php endforeach; ?>
            </ul>
        </dd>
    </div>
</dl>
